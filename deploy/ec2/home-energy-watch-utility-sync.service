[Unit]
Description=Home Energy Watch utility history refresh
Wants=network-online.target
After=network-online.target docker.service home-energy-watch.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/home-energy-watch
ExecStart=/bin/bash /home/ubuntu/home-energy-watch/deploy/ec2/home-energy-watch-utility-sync.sh
