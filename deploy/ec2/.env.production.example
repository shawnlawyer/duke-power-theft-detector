# Production environment for deploy/ec2/home-energy-watch-direct.sh (web) and
# home-energy-watch-utility-sync.sh (timer). The web launcher reads this file
# with bash and the utility sync passes it to `docker run --env-file`, so keep
# every value on one line as plain KEY=value: no quotes, no `$`, no `&`, and no
# trailing comments.

# Host port and bind address for the published container port.
# POWER_BIND_ADDRESS unset/blank keeps the historical behavior (publish on all
# host interfaces). Behind a TLS reverse proxy on the same host, set
# POWER_BIND_ADDRESS=127.0.0.1 so the plain-HTTP port is not reachable from the
# network. (Use [::1] for IPv6 loopback.)
POWER_WEB_PORT=80
POWER_BIND_ADDRESS=

# Image the web service and utility sync run. Leave unset to use
# home-energy-watch:current, which scripts/deploy-production.sh maintains
# (with :previous for rollback and :<git-sha> per release).
# HEW_IMAGE=home-energy-watch:current

# Optional, read by scripts/deploy-production.sh on the operator workstation
# (export it in the shell there; it is not used by the container). When set,
# every deploy first creates an RDS snapshot of this instance and waits for it.
# HEW_RDS_INSTANCE_ID=home-energy-watch-pg

POWER_ENV=production
POWER_APP_SECRET=replace-with-a-long-random-secret
POWER_AUDIT_SIGNING_KEY=
POWER_DATA_ENCRYPTION_KEY=
# TLS is required. sslmode=require encrypts but does not verify the server
# certificate. Recommended: sslmode=verify-full with the AWS RDS CA bundle
# (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem), i.e.
#   postgresql://...:5432/powerpattern?sslmode=verify-full&sslrootcert=/srv/home-energy-watch/input/rds-global-bundle.pem
# Because `&` is not safe in this file (see header), express the same thing as:
#   POWER_DATABASE_URL=postgresql://...:5432/powerpattern?sslmode=verify-full
#   PGSSLROOTCERT=/srv/home-energy-watch/input/rds-global-bundle.pem
# and place the bundle at /opt/home-energy-watch/input/rds-global-bundle.pem on
# the host (readable by uid 10001). libpq reads PGSSLROOTCERT from the env.
POWER_DATABASE_URL=postgresql://powerpattern:replace-with-rds-password@your-rds-endpoint:5432/powerpattern?sslmode=require
POWER_PUBLIC_BASE_URL=https://app.homeenergywatch.com
POWER_MARKETING_BASE_URL=https://homeenergywatch.com
POWER_TRUST_PROXY=true
POWER_LOG_LEVEL=INFO
POWER_LOG_FORMAT=json
POWER_STAFF_MFA_REQUIRED=false
POWER_DATA_DELETION_ENABLED=false
POWER_DATA_DELETION_POLICY_VERSION=
POWER_TIMEZONE=America/New_York
POWER_EMAIL_BACKEND=ses
POWER_EMAIL_FROM=support@homeenergywatch.com
POWER_EMAIL_REPLY_TO=
POWER_EMAIL_REGION=us-east-1
POWER_WEB_CONCURRENCY=3
POWER_GUNICORN_TIMEOUT=120

# Optional Amazon Bedrock assistant (uses the EC2 instance role).
POWER_BEDROCK_ENABLED=false
POWER_BEDROCK_REGION=us-east-1
POWER_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Direct Stripe billing. Keep secret values in the production secret store.
# Home Watch is billed annually: $239.88/year per electric account.
# STRIPE_PRICE_HOME must be that annual Stripe Price ID.
# STRIPE_PRICE_REVIEW is not used by the current plans.
POWER_BILLING_ENABLED=false
STRIPE_ACCOUNT_ID=acct_1TEP6v39IosmExPF
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_PRICE_HOME=
STRIPE_PRICE_REVIEW=

# Detection tuning
POWER_NIGHT_START=02:00
POWER_NIGHT_END=04:00
POWER_MIN_NIGHT_KW=1.0
POWER_NIGHT_MULTIPLIER=2.0
POWER_ALERT_WINDOW_START=00:00
POWER_ALERT_WINDOW_END=05:00
POWER_ALERT_MIN_KW=1.2
POWER_ALERT_MULTIPLIER=1.5
POWER_ALERT_JUMP_KW=0.75

# Setup code for creating the first commissioner on an empty database. Remove after first run.
# POWER_FIRST_RUN_TOKEN=
# Optional allow-list of utility export hosts, comma separated. Export URLs must be https on a public address.
# POWER_UTILITY_EXPORT_HOSTS=
